OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Martivi Website <onboarding@resend.dev>

# Admin panel (/admin) — required to log in and save changes.
ADMIN_PASSWORD=
# Random string used to sign admin session cookies, e.g. `openssl rand -base64 32`.
SESSION_SECRET=
# Attach a Vercel Blob store to the project to get this (Vercel dashboard or
# Marketplace). Without it, /projects still renders the static seed data,
# but the admin panel can't save projects or upload images.
BLOB_READ_WRITE_TOKEN=
